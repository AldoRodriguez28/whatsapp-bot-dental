# ──────────────────────────────────────────────
# WhatsApp Bot Dental – example environment vars
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# Server port (default 3000)
PORT=3000

# ── WhatsApp / Meta ───────────────────────────
# Verification token set in the Meta App Dashboard webhook config
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# Permanent access token from Meta App (used as fallback; primary token lives in the clinic DB row)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# Phone Number ID from Meta App (used as fallback; primary value lives in the clinic DB row)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# HMAC secret for validating X-Hub-Signature-256 (either name is accepted)
APP_SECRET=your_app_secret_here
WHATSAPP_APP_SECRET=your_app_secret_here

# Set to "true" to skip actual WhatsApp API calls during development/testing
TEST_MODE=false

# ── Database ──────────────────────────────────
# Postgres connection string (Neon, Supabase, Railway, or local)
DATABASE_URL=postgresql://user:password@host:5432/dental_bot?schema=public

# ── Anthropic / Claude ────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Model to use; defaults to claude-opus-4-8 if not set
ANTHROPIC_MODEL=claude-opus-4-8

# ── Google Calendar ───────────────────────────
# Full JSON of a Google service-account key (single-line or base64-encoded)
# Share each clinic's Google Calendar with the service account's client_email.
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"bot@project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ── Reminders cron ────────────────────────────
# Secret bearer token that protects POST /reminders/run
# Must match the Authorization header sent by the external cron job
REMINDERS_TOKEN=your_random_secret_token_here

# ── Seed script (optional – only needed for prisma db seed) ──
# Override the default clinic record created by the seed script
SEED_WA_PHONE_NUMBER_ID=DEV_PHONE_ID
SEED_WA_ACCESS_TOKEN=DEV_TOKEN
SEED_GOOGLE_CALENDAR_ID=primary
